# Copy to .env and edit. Never commit .env.

# --- AI provider -------------------------------------------------------------
# echo   = no AI, repeats the question (testing only, no key needed)
# gemini = Google Gemini, free key from Google AI Studio
# groq   = Groq, free key from the Groq console
# openai_compatible = any other OpenAI-style service (also set LLM_BASE_URL and LLM_MODEL)
LLM_PROVIDER=echo
LLM_API_KEY=
# Optional: override the provider's default endpoint or model.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TIMEOUT=20

# --- Course data -------------------------------------------------------------
COURSES_PATH=data/courses.json
# Where course pages live, so answers can link to them (no trailing slash).
# Leave empty for relative links (/courses-details/<slug>).
# Course and help links start with this. Set it even when testing locally, or links point at localhost.
LMS_BASE_URL=https://curiosity.live

# --- Browser access ----------------------------------------------------------
# Websites allowed to call this API from a browser (the LMS site), comma separated.
# In production use the exact address visitors see, e.g. https://curiosity.live
ALLOWED_ORIGINS=http://localhost:8000

# --- Demo ----------------------------------------------------------------------
# Serve /demo, a sample page with the widget on it. Turn on for local testing only.
# DEMO_PAGE=true

# --- Rate limits (per visitor address; 0 turns one off) ----------------------
# RATE_PER_MINUTE=10
# RATE_PER_DAY=150
# Total questions per day for everyone, so a bot cannot use up the free AI quota.
# RATE_GLOBAL_PER_DAY=2000
